<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stories"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real farmers sharing successful farming practices and results."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"/>

        <!-- STORIES VIEWPAGER -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="560dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/storyViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"/>

        </androidx.cardview.widget.CardView>

        <!-- INFO NOTE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="These stories are collected to help farmers learn practical techniques and improve crop yield."
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="18dp"
            android:paddingStart="4dp"/>

    </LinearLayout>

</ScrollView>